{
  "name": "msnodesqlv8-electron",
  "version": "1.1.2",
  "description": "electron js with msnodesqlv8",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "electron:dev": "electron . --dev",
    "test": "echo \"Error: no test specified\" && exit 1",
    "pack": "electron-builder --dir"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "msnodesqlv8": "^5.5.0"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.timelorduk.msnodesqlv8-electron",
    "productName": "msnodesqlv8-electron",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "dir"
    },
    "linux": {
      "target": "dir"
    },
    "mac": {
      "target": "dir"
    }
  }
}
